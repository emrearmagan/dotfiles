#!/usr/bin/env bash

# Manage local branch review notes.
# Notes are stored as formatted JSON under:
#   <canonical-repo-root>/.notes/<branch>/notes.json

set -euo pipefail

need() {
	command -v "$1" >/dev/null 2>&1 || {
		printf 'Missing dependency: %s\n' "$1" >&2
		exit 1
	}
}

validate_single_line() {
	local label="$1" value="$2"
	case "$value" in
	*$'\r'* | *$'\n'*)
		printf '%s must be a single line.\n' "$label" >&2
		return 1
		;;
	esac
}

usage() {
	printf 'Usage:\n' >&2
	printf '  %s path [--branch <branch>]\n' "$(basename "$0")" >&2
	printf '  %s branches [--json] [--all]\n' "$(basename "$0")" >&2
	printf '  %s add --file <path> --line <line> --body <text> [options]\n' "$(basename "$0")" >&2
	printf '  %s update <id> [options]\n' "$(basename "$0")" >&2
	printf '  %s list [--branch <branch>] [--json] [--all|--archived]\n' "$(basename "$0")" >&2
	printf '  %s delete <id> [--branch <branch>]\n' "$(basename "$0")" >&2
	printf '  %s archive [<id>] [--branch <branch>] [--unarchive] [--reason <text>]\n' "$(basename "$0")" >&2
	printf '  %s clear [--branch <branch>] --yes\n' "$(basename "$0")" >&2
	printf '  %s delete-branch --branch <branch> --yes\n' "$(basename "$0")" >&2
	printf '\nOptions for add/update:\n' >&2
	printf '      --title <text>             note title\n' >&2
	printf '      --importance <level>       critical, important, or minor\n' >&2
	printf '      --source <name>            free-form source label (default: pi)\n' >&2
	printf '      --branch <branch>          branch notes bucket (default: current branch)\n' >&2
	printf '      --provider <name>          optional PR provider\n' >&2
	printf '      --repo <owner/name>        optional provider repository\n' >&2
	printf '      --pr-id <id>               optional PR id/number\n' >&2
}

need git
need jq
need uuidgen

worktree_root() {
	git rev-parse --show-toplevel 2>/dev/null || {
		printf 'Not inside a git repository.\n' >&2
		exit 1
	}
}

canonical_repo_root() {
	local configured common record
	configured="$(git config --path --get core.worktree 2>/dev/null || true)"
	if [ -n "$configured" ]; then
		case "$configured" in
		/*) printf '%s\n' "$configured" ;;
		*)
			common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
			[ -n "$common" ] && (cd "$common/$configured" && pwd -P) || worktree_root
			;;
		esac
		return 0
	fi
	while IFS= read -r -d '' record; do
		case "$record" in
		"worktree "*)
			printf '%s\n' "${record#worktree }"
			return 0
			;;
		esac
	done < <(git worktree list --porcelain -z 2>/dev/null)
	worktree_root
}

note_branch() {
	local branch sha
	branch="$(git branch --show-current 2>/dev/null || true)"
	if [ -n "$branch" ]; then
		printf '%s\n' "$branch"
		return
	fi

	sha="$(git rev-parse --short=12 HEAD 2>/dev/null || true)"
	printf 'detached-%s\n' "${sha:-HEAD}"
}

notes_root() {
	printf '%s/.notes\n' "$(canonical_repo_root)"
}

validate_branch() {
	if [ -z "$1" ] || [ "${1#-}" != "$1" ] || ! git check-ref-format "refs/heads/$1" >/dev/null 2>&1; then
		printf 'Invalid notes branch: %s\n' "$1" >&2
		return 1
	fi
}

validate_notes_directory() {
	local directory="$1" branch="$2" segment
	if [ -L "$directory" ] || { [ -e "$directory" ] && [ ! -d "$directory" ]; }; then
		printf 'Unsafe notes path: %s\n' "$directory" >&2
		return 1
	fi
	while [ -n "$branch" ]; do
		segment="${branch%%/*}"
		directory="$directory/$segment"
		if [ -L "$directory" ] || { [ -e "$directory" ] && [ ! -d "$directory" ]; }; then
			printf 'Unsafe notes path: %s\n' "$directory" >&2
			return 1
		fi
		if [ "$branch" = "$segment" ]; then
			break
		fi
		branch="${branch#*/}"
	done
}

notes_dir_for_branch() {
	local root
	validate_branch "$1" || return 1
	root="$(notes_root)"
	validate_notes_directory "$root" "$1" || return 1
	printf '%s/%s\n' "$root" "$1"
}

notes_file_for_branch() {
	local dir file
	dir="$(notes_dir_for_branch "$1")" || return 1
	file="$dir/notes.json"
	if [ -L "$file" ] || { [ -e "$file" ] && [ ! -f "$file" ]; }; then
		printf 'Unsafe notes path: %s\n' "$file" >&2
		return 1
	fi
	printf '%s\n' "$file"
}

selected_branch() {
	if [ -n "${1:-}" ]; then
		validate_branch "$1" || return 1
		printf '%s\n' "$1"
	else
		note_branch
	fi
}

notes_file() {
	notes_file_for_branch "$(note_branch)"
}

write_json() {
	local target="$1" tmp
	mkdir -p "$(dirname "$target")"
	tmp="$(mktemp "$(dirname "$target")/.notes.XXXXXX")"
	cat >"$tmp"
	if [ ! -s "$tmp" ] || ! jq -se 'length == 1' "$tmp" >/dev/null 2>&1; then
		rm -f "$tmp"
		return 1
	fi
	if ! validate_notes_file "$tmp"; then
		rm -f "$tmp"
		return 1
	fi
	mv "$tmp" "$target"
}

validate_notes_file() {
	local file="$1"
	[ ! -e "$file" ] && return 0
	if [ ! -s "$file" ] || ! jq -se '
		def single_line:
			type == "string"
			and (contains("\r") | not)
			and (contains("\n") | not)
			and (contains("\u0000") | not);
		def optional_single_line($key):
			(has($key) | not) or (.[$key] | single_line);

		length == 1
		and (.[0]
			| type == "object"
			and ((has("version") | not) or .version == 1)
			and ((.meta // {}) | type == "object")
			and ((.meta // {})
				| optional_single_line("branch")
				and optional_single_line("created_at")
				and optional_single_line("updated_at"))
			and optional_single_line("created_at")
			and optional_single_line("updated_at")
			and ((.notes // []) | type == "array")
			and (((.notes // []) | all(.[];
				type == "object"
				and ((.id | type) == "string")
				and ((.id | length) > 0)
				and optional_single_line("id")
				and optional_single_line("source")
				and optional_single_line("title")
				and optional_single_line("provider")
				and optional_single_line("repo_full_name")
				and ((has("pr_id") | not) or ((.pr_id | type) == "number") or (.pr_id | single_line))
				and optional_single_line("head_sha")
				and optional_single_line("branch")
				and optional_single_line("created_at")
				and optional_single_line("updated_at")
				and optional_single_line("archived_at")
				and optional_single_line("archive_reason")
				and ((.file_path | type) == "string")
				and ((.file_path | length) > 0)
				and ((.file_path | startswith("/")) | not)
				and ((.file_path | test("^[A-Za-z]:/")) | not)
				and ((.file_path | contains("\\")) | not)
				and ((.file_path | contains("\r")) | not)
				and ((.file_path | contains("\n")) | not)
				and ((.file_path | contains("\u0000")) | not)
				and ((.file_path | split("/") | all(. != "..")))
				and ((.line | type) == "number")
				and (.line >= 1)
				and (.line == (.line | floor))
				and ((.body | type) == "string")
				and ((.body | contains("\u0000")) | not)
				and (.body | test("\\S"))
				and ((has("importance") | not) or (.importance == "minor" or .importance == "important" or .importance == "critical"))
			)))
			and (((.notes // []) | map(.id | tostring) | length) == ((.notes // []) | map(.id | tostring) | unique | length)))
	' "$file" >/dev/null 2>&1; then
		printf 'Invalid notes file: %s\n' "$file" >&2
		return 1
	fi
}

notes_lock=""

release_notes_lock() {
	if [ -n "$notes_lock" ]; then
		rmdir "$notes_lock" 2>/dev/null || true
		notes_lock=""
	fi
}

acquire_notes_lock() {
	local root lock lock_error stale attempts=0
	root="$(notes_root)"
	lock="$root/.lock"
	mkdir -p "$root"
	while ! lock_error="$(mkdir "$lock" 2>&1)"; do
		if [ ! -e "$lock" ]; then
			printf 'Unable to acquire notes lock: %s\n' "${lock_error:-unknown filesystem error}" >&2
			exit 1
		fi
		if [ ! -d "$lock" ]; then
			printf 'Unable to acquire notes lock: %s is not a directory.\n' "$lock" >&2
			exit 1
		fi
		if [ -n "$(find "$lock" -prune -mmin +1 -print -quit 2>/dev/null)" ]; then
			stale="$root/.lock.stale.$$.$attempts"
			if mv "$lock" "$stale" 2>/dev/null; then
				rmdir "$stale" 2>/dev/null || true
			fi
			continue
		fi
		attempts=$((attempts + 1))
		if [ "$attempts" -ge 200 ]; then
			printf 'Notes are being updated by another process.\n' >&2
			exit 1
		fi
		sleep 0.025
	done
	notes_lock="$lock"
	trap release_notes_lock EXIT
}

now_utc() {
	date -u '+%Y-%m-%dT%H:%M:%SZ'
}

new_id() {
	printf 'note_%s\n' "$(uuidgen | tr '[:upper:]' '[:lower:]' | tr -d '-' | cut -c 1-12)"
}

head_ref_for() {
	local branch="$1"
	if git rev-parse --verify --quiet "refs/heads/$branch" >/dev/null; then
		printf 'refs/heads/%s\n' "$branch"
	elif git rev-parse --verify --quiet "refs/remotes/origin/$branch" >/dev/null; then
		printf 'refs/remotes/origin/%s\n' "$branch"
	elif git rev-parse --verify --quiet "$branch" >/dev/null; then
		printf '%s\n' "$branch"
	elif [ "$branch" = "$(note_branch)" ]; then
		printf 'HEAD\n'
	fi
}

head_sha_for() {
	local ref
	ref="$(head_ref_for "$1")"
	[ -n "$ref" ] && git rev-parse "$ref" 2>/dev/null || true
}

relative_path() {
	local wt="$1" input="$2"
	validate_single_line "Note file path" "$input" || return 1
	input="${input//\\//}"
	case "$input" in
	"$wt"/*) printf '%s\n' "${input#"$wt"/}" ;;
	./*) printf '%s\n' "${input#./}" ;;
	*) printf '%s\n' "$input" ;;
	esac
}

validate_relative_path() {
	validate_single_line "Note file path" "$1" || return 1
	case "$1" in
	"" | /* | [[:alpha:]]:/* | .. | ../* | */../* | */..)
		printf 'Note file paths must stay inside the repository: %s\n' "$1" >&2
		return 1
		;;
	esac
}

empty_document() {
	local branch="$1" now="$2"
	jq -n --arg branch "$branch" --arg now "$now" '{version:1,meta:{branch:$branch,created_at:$now,updated_at:$now},notes:[]}'
}

cmd_path() {
	local branch=""
	while [ "$#" -gt 0 ]; do
		case "$1" in
		--branch)
			branch="${2:-}"
			shift 2
			;;
		--branch=*)
			branch="${1#--branch=}"
			shift
			;;
		-h | --help)
			usage
			exit 0
			;;
		*)
			printf 'Unknown option: %s\n' "$1" >&2
			exit 1
			;;
		esac
	done
	notes_file_for_branch "$(selected_branch "$branch")"
}

cmd_branches() {
	local json_output=0 include_archived=0 root
	while [ "$#" -gt 0 ]; do
		case "$1" in
		--json)
			json_output=1
			shift
			;;
		--all | --archived)
			include_archived=1
			shift
			;;
		-h | --help)
			usage
			exit 0
			;;
		*)
			printf 'Unknown option: %s\n' "$1" >&2
			exit 1
			;;
		esac
	done

	root="$(notes_root)"
	validate_notes_directory "$root" "" || return 1
	if [ ! -d "$root" ]; then
		[ "$json_output" -eq 1 ] && printf '[]\n'
		return 0
	fi

	if [ "$json_output" -eq 1 ]; then
		find "$root" -type f -name notes.json -print0 | while IFS= read -r -d '' file; do
			local rel branch
			rel="${file#"$root"/}"
			branch="${rel%/notes.json}"
			validate_branch "$branch" >/dev/null 2>&1 || continue
			validate_notes_file "$file"
			jq -c --arg branch "$branch" --arg path "$file" --argjson include_archived "$include_archived" '
				(.notes // []) as $notes
				| ($notes | map(select(.archived != true)) | length) as $active
				| ($notes | map(select(.archived == true)) | length) as $archived
				| if type == "object" and ($active > 0 or ($include_archived == 1 and $archived > 0)) then
					{
						branch:$branch,
						notes_count:$active,
						archived_count:$archived,
						created_at:(.meta.created_at // ""),
						updated_at:(.meta.updated_at // ""),
						path:$path
					}
				else empty end
			' "$file"
		done | jq -s 'sort_by(.branch)'
	else
		find "$root" -type f -name notes.json -print0 | while IFS= read -r -d '' file; do
			local rel branch
			rel="${file#"$root"/}"
			branch="${rel%/notes.json}"
			validate_branch "$branch" >/dev/null 2>&1 || continue
			validate_notes_file "$file"
			jq -r --arg branch "$branch" --arg path "$file" --argjson include_archived "$include_archived" '
				(.notes // []) as $notes
				| ($notes | map(select(.archived != true)) | length) as $active
				| ($notes | map(select(.archived == true)) | length) as $archived
				| if type == "object" and ($active > 0 or ($include_archived == 1 and $archived > 0)) then
					[$branch, $active, $archived, (.meta.updated_at // ""), $path] | @tsv
				else empty end
			' "$file"
		done
	fi
}

cmd_add() {
	local file="" line="" body="" title="" importance="minor" source="pi" branch="" provider="" repo_full_name="" pr_id=""

	while [ "$#" -gt 0 ]; do
		case "$1" in
		--file)
			file="${2:-}"
			shift 2
			;;
		--file=*)
			file="${1#--file=}"
			shift
			;;
		--line)
			line="${2:-}"
			shift 2
			;;
		--line=*)
			line="${1#--line=}"
			shift
			;;
		--body)
			body="${2:-}"
			shift 2
			;;
		--body=*)
			body="${1#--body=}"
			shift
			;;
		--title)
			title="${2:-}"
			shift 2
			;;
		--title=*)
			title="${1#--title=}"
			shift
			;;
		--importance)
			importance="${2:-}"
			shift 2
			;;
		--importance=*)
			importance="${1#*=}"
			shift
			;;
		--source)
			source="${2:-}"
			shift 2
			;;
		--source=*)
			source="${1#--source=}"
			shift
			;;
		--branch)
			branch="${2:-}"
			shift 2
			;;
		--branch=*)
			branch="${1#--branch=}"
			shift
			;;
		--provider)
			provider="${2:-}"
			shift 2
			;;
		--provider=*)
			provider="${1#--provider=}"
			shift
			;;
		--repo | --repo-full-name)
			repo_full_name="${2:-}"
			shift 2
			;;
		--repo=* | --repo-full-name=*)
			repo_full_name="${1#*=}"
			shift
			;;
		--pr-id)
			pr_id="${2:-}"
			shift 2
			;;
		--pr-id=*)
			pr_id="${1#--pr-id=}"
			shift
			;;
		-h | --help)
			usage
			exit 0
			;;
		*)
			printf 'Unknown option: %s\n' "$1" >&2
			usage
			exit 1
			;;
		esac
	done

	if [ -z "$file" ] || [ -z "$line" ] || ! [[ "$body" =~ [^[:space:]] ]]; then
		printf 'add requires --file, --line, and --body.\n' >&2
		usage
		exit 1
	fi
	validate_single_line "Note title" "$title"
	validate_single_line "Note source" "$source"
	validate_single_line "Note provider" "$provider"
	validate_single_line "Note repository" "$repo_full_name"
	validate_single_line "Note pull request id" "$pr_id"
	if ! [[ "$line" =~ ^[0-9]+$ ]] || [ "$line" -lt 1 ]; then
		printf 'Invalid --line: %s\n' "$line" >&2
		exit 1
	fi
	line="$((10#$line))"

	case "$importance" in
	"" | critical | important | minor) ;;
	*)
		printf 'Invalid --importance: %s\n' "$importance" >&2
		exit 1
		;;
	esac
	if [ -z "$source" ]; then
		printf '%s\n' '--source cannot be empty.' >&2
		exit 1
	fi

	local wt rel id created selected note_file note_json
	wt="$(worktree_root)"
	selected="$(selected_branch "$branch")"
	rel="$(relative_path "$wt" "$file")"
	validate_relative_path "$rel"
	id="$(new_id)"
	created="$(now_utc)"
	note_file="$(notes_file_for_branch "$selected")"

	note_json="$({
		jq -cn \
			--arg id "$id" \
			--arg source "$source" \
			--arg provider "$provider" \
			--arg repo_full_name "$repo_full_name" \
			--arg pr_id "$pr_id" \
			--arg branch "$selected" \
			--arg head_sha "$(head_sha_for "$selected")" \
			--arg file_path "$rel" \
			--argjson line "$line" \
			--arg importance "$importance" \
			--arg title "$title" \
			--arg body "$body" \
			--arg created_at "$created" \
			'{
				id:$id,
				source:$source,
				branch:$branch,
				file_path:$file_path,
				line:$line,
				body:$body,
				created_at:$created_at
			}
			+ (if $provider == "" then {} else {provider:$provider} end)
			+ (if $repo_full_name == "" then {} else {repo_full_name:$repo_full_name} end)
			+ (if $pr_id == "" then {} else {pr_id:$pr_id} end)
			+ (if $head_sha == "" then {} else {head_sha:$head_sha} end)
			+ (if $importance == "" then {} else {importance:$importance} end)
			+ (if $title == "" then {} else {title:$title} end)'
	})"

	acquire_notes_lock
	validate_notes_file "$note_file"
	if [ -s "$note_file" ]; then
		jq --argjson note "$note_json" --arg branch "$selected" --arg now "$created" '
			if type == "object" then . else {version:1,meta:{branch:$branch,created_at:$now},notes:[]} end
			| .version = 1
			| .meta.branch = $branch
			| .meta.created_at = (.meta.created_at // $now)
			| .meta.updated_at = $now
			| .notes = (((.notes // []) | map(
				.branch = $branch
				| .importance = (.importance // "minor")
			)) + [$note])
		' "$note_file" | write_json "$note_file"
	else
		jq -n --argjson note "$note_json" --arg branch "$selected" --arg now "$created" '{version:1,meta:{branch:$branch,created_at:$now,updated_at:$now},notes:[$note]}' | write_json "$note_file"
	fi
	printf '%s\n' "$id"
}

cmd_update() {
	local id="" file="" line="" body="" title="" importance="" source="" branch="" provider="" repo_full_name="" pr_id=""
	local has_file=0 has_line=0 has_body=0 has_title=0 has_importance=0 has_source=0 has_provider=0 has_repo=0 has_pr_id=0

	while [ "$#" -gt 0 ]; do
		case "$1" in
		--file)
			file="${2:-}"
			has_file=1
			shift 2
			;;
		--file=*)
			file="${1#--file=}"
			has_file=1
			shift
			;;
		--line)
			line="${2:-}"
			has_line=1
			shift 2
			;;
		--line=*)
			line="${1#--line=}"
			has_line=1
			shift
			;;
		--body)
			body="${2:-}"
			has_body=1
			shift 2
			;;
		--body=*)
			body="${1#--body=}"
			has_body=1
			shift
			;;
		--title)
			title="${2:-}"
			has_title=1
			shift 2
			;;
		--title=*)
			title="${1#--title=}"
			has_title=1
			shift
			;;
		--importance)
			importance="${2:-}"
			has_importance=1
			shift 2
			;;
		--importance=*)
			importance="${1#*=}"
			has_importance=1
			shift
			;;
		--source)
			source="${2:-}"
			has_source=1
			shift 2
			;;
		--source=*)
			source="${1#--source=}"
			has_source=1
			shift
			;;
		--branch)
			branch="${2:-}"
			shift 2
			;;
		--branch=*)
			branch="${1#--branch=}"
			shift
			;;
		--provider)
			provider="${2:-}"
			has_provider=1
			shift 2
			;;
		--provider=*)
			provider="${1#--provider=}"
			has_provider=1
			shift
			;;
		--repo | --repo-full-name)
			repo_full_name="${2:-}"
			has_repo=1
			shift 2
			;;
		--repo=* | --repo-full-name=*)
			repo_full_name="${1#*=}"
			has_repo=1
			shift
			;;
		--pr-id)
			pr_id="${2:-}"
			has_pr_id=1
			shift 2
			;;
		--pr-id=*)
			pr_id="${1#--pr-id=}"
			has_pr_id=1
			shift
			;;
		-h | --help)
			usage
			exit 0
			;;
		*)
			if [ -z "$id" ]; then
				id="$1"
				shift
			else
				printf 'Unknown argument: %s\n' "$1" >&2
				exit 1
			fi
			;;
		esac
	done

	if [ -z "$id" ]; then
		printf 'update requires a note id.\n' >&2
		exit 1
	fi
	validate_single_line "Note id" "$id"
	validate_single_line "Note title" "$title"
	validate_single_line "Note source" "$source"
	validate_single_line "Note provider" "$provider"
	validate_single_line "Note repository" "$repo_full_name"
	validate_single_line "Note pull request id" "$pr_id"
	if [ "$has_file" -eq 1 ] && [ -z "$file" ]; then
		printf 'update --file cannot be empty.\n' >&2
		exit 1
	fi
	if [ "$has_line" -eq 1 ]; then
		if ! [[ "$line" =~ ^[0-9]+$ ]] || [ "$line" -lt 1 ]; then
			printf 'Invalid --line: %s\n' "$line" >&2
			exit 1
		fi
		line="$((10#$line))"
	fi
	if [ "$has_body" -eq 1 ] && ! [[ "$body" =~ [^[:space:]] ]]; then
		printf 'update --body cannot be empty.\n' >&2
		exit 1
	fi
	if [ "$has_importance" -eq 1 ]; then
		case "$importance" in
		critical | important | minor) ;;
		*)
			printf 'Invalid --importance: %s\n' "$importance" >&2
			exit 1
			;;
		esac
	fi
	if [ "$has_source" -eq 1 ] && [ -z "$source" ]; then
		printf '%s\n' 'update --source cannot be empty.' >&2
			exit 1
	fi
	if [ "$has_file" -eq 0 ] && [ "$has_line" -eq 0 ] && [ "$has_body" -eq 0 ] && [ "$has_title" -eq 0 ] && [ "$has_importance" -eq 0 ] && [ "$has_source" -eq 0 ] && [ "$has_provider" -eq 0 ] && [ "$has_repo" -eq 0 ] && [ "$has_pr_id" -eq 0 ]; then
		printf 'update requires at least one field option.\n' >&2
		exit 1
	fi

	local wt rel selected note_file now current_head reanchor
	wt="$(worktree_root)"
	selected="$(selected_branch "$branch")"
	note_file="$(notes_file_for_branch "$selected")"
	acquire_notes_lock
	validate_notes_file "$note_file"
	[ -f "$note_file" ] || {
		printf 'Note not found: %s\n' "$id" >&2
		exit 1
	}
	jq -e --arg id "$id" 'if type == "object" then any((.notes // [])[]; .id == $id) else false end' "$note_file" >/dev/null || {
		printf 'Note not found: %s\n' "$id" >&2
		exit 1
	}

	now="$(now_utc)"
	reanchor=0
	if [ "$has_file" -eq 1 ] || [ "$has_line" -eq 1 ]; then
		reanchor=1
	fi
	current_head="$(head_sha_for "$selected")"
	rel="$file"
	if [ "$has_file" -eq 1 ]; then
		rel="$(relative_path "$wt" "$file")"
		validate_relative_path "$rel"
	fi
	jq \
		--arg id "$id" \
		--arg branch "$selected" \
		--arg now "$now" \
		--arg head_sha "$current_head" \
		--arg reanchor "$reanchor" \
		--arg has_file "$has_file" \
		--arg file_path "$rel" \
		--arg has_line "$has_line" \
		--argjson line "${line:-0}" \
		--arg has_body "$has_body" \
		--arg body "$body" \
		--arg has_title "$has_title" \
		--arg title "$title" \
		--arg has_importance "$has_importance" \
		--arg importance "$importance" \
		--arg has_source "$has_source" \
		--arg source "$source" \
		--arg has_provider "$has_provider" \
		--arg provider "$provider" \
		--arg has_repo "$has_repo" \
		--arg repo_full_name "$repo_full_name" \
		--arg has_pr_id "$has_pr_id" \
		--arg pr_id "$pr_id" \
		'
			def set_string($key; $enabled; $value):
				if $enabled == "1" then
					if $value == "" then del(.[$key]) else .[$key] = $value end
				else . end;

			if type == "object" then . else {version:1,meta:{branch:$branch,created_at:$now},notes:[]} end
			| .version = 1
			| .meta.branch = $branch
			| .meta.created_at = (.meta.created_at // $now)
			| .meta.updated_at = $now
			| .notes = ((.notes // []) | map(
				.branch = $branch
				| .importance = (.importance // "minor")
				| if .id == $id then
					.
					| .branch = $branch
					| .updated_at = $now
					| set_string("head_sha"; $reanchor; $head_sha)
					| set_string("file_path"; $has_file; $file_path)
					| if $has_line == "1" then .line = $line else . end
					| if $has_body == "1" then .body = $body else . end
					| set_string("title"; $has_title; $title)
					| set_string("importance"; $has_importance; $importance)
					| if $has_source == "1" then .source = $source else . end
					| set_string("provider"; $has_provider; $provider)
					| set_string("repo_full_name"; $has_repo; $repo_full_name)
					| set_string("pr_id"; $has_pr_id; $pr_id)
				else . end
			))
		' "$note_file" | write_json "$note_file"
	printf '%s\n' "$id"
}

cmd_list() {
	local json_output=0 include_archived=0 archived_only=0 branch="" selected note_file
	while [ "$#" -gt 0 ]; do
		case "$1" in
		--json)
			json_output=1
			shift
			;;
		--all)
			include_archived=1
			shift
			;;
		--archived)
			archived_only=1
			shift
			;;
		--branch)
			branch="${2:-}"
			shift 2
			;;
		--branch=*)
			branch="${1#--branch=}"
			shift
			;;
		-h | --help)
			usage
			exit 0
			;;
		*)
			printf 'Unknown option: %s\n' "$1" >&2
			exit 1
			;;
		esac
	done

	selected="$(selected_branch "$branch")"
	note_file="$(notes_file_for_branch "$selected")"
	if [ ! -e "$note_file" ]; then
		[ "$json_output" -eq 1 ] && printf '[]\n'
		return 0
	fi
	validate_notes_file "$note_file"

	if [ "$json_output" -eq 1 ]; then
		jq --arg branch "$selected" --argjson include_archived "$include_archived" --argjson archived_only "$archived_only" '
			if type == "object" then
				(.notes // [])
				| map(select(
					if $archived_only == 1 then .archived == true
					elif $include_archived == 1 then true
					else .archived != true end
				))
				| map(
					.branch = $branch
					| .importance = (.importance // "minor")
				)
			else [] end
		' "$note_file"
	else
		jq -r --argjson include_archived "$include_archived" --argjson archived_only "$archived_only" '
			if type == "object" then
				(.notes // [])[]
				| select(
					if $archived_only == 1 then .archived == true
					elif $include_archived == 1 then true
					else .archived != true end
				)
				| [.id, (.importance // "minor"), ((.file_path // "") + ":" + ((.line // 0) | tostring)), (.title // ((.body // "") | split("\n")[0][0:80]))]
				| @tsv
			else empty end
		' "$note_file"
	fi
}

cmd_delete() {
	local id="" branch="" selected note_file now
	while [ "$#" -gt 0 ]; do
		case "$1" in
		--branch)
			branch="${2:-}"
			shift 2
			;;
		--branch=*)
			branch="${1#--branch=}"
			shift
			;;
		*)
			if [ -z "$id" ]; then
				id="$1"
				shift
			else
				printf 'Unknown argument: %s\n' "$1" >&2
				exit 1
			fi
			;;
		esac
	done
	if [ -z "$id" ]; then
		printf 'delete requires a note id.\n' >&2
		exit 1
	fi
	validate_single_line "Note id" "$id"

	selected="$(selected_branch "$branch")"
	note_file="$(notes_file_for_branch "$selected")"
	acquire_notes_lock
	validate_notes_file "$note_file"
	[ -f "$note_file" ] || {
		printf 'Note not found: %s\n' "$id" >&2
		exit 1
	}
	jq -e --arg id "$id" 'any((.notes // [])[]; (.id | tostring) == $id)' "$note_file" >/dev/null || {
		printf 'Note not found: %s\n' "$id" >&2
		exit 1
	}
	now="$(now_utc)"

	jq --arg branch "$selected" --arg id "$id" --arg now "$now" '
		if type == "object" then . else {version:1,meta:{branch:$branch,created_at:$now},notes:[]} end
		| .version = 1
		| .notes = ((.notes // []) | map(
			.branch = $branch
			| .importance = (.importance // "minor")
		) | map(select(.id != $id)))
		| .meta.updated_at = $now
	' "$note_file" | write_json "$note_file"
	printf '%s\n' "$id"
}

cmd_archive() {
	local id="" branch="" reason="" archived=1 selected note_file now matches
	while [ "$#" -gt 0 ]; do
		case "$1" in
		--branch)
			branch="${2:-}"
			shift 2
			;;
		--branch=*)
			branch="${1#--branch=}"
			shift
			;;
		--reason)
			reason="${2:-}"
			shift 2
			;;
		--reason=*)
			reason="${1#--reason=}"
			shift
			;;
		--unarchive | --undo)
			archived=0
			shift
			;;
		-h | --help)
			usage
			exit 0
			;;
		*)
			if [ -z "$id" ]; then
				id="$1"
				shift
			else
				printf 'Unknown argument: %s\n' "$1" >&2
				exit 1
			fi
			;;
		esac
	done
	validate_single_line "Note id" "$id"
	validate_single_line "Note archive reason" "$reason"

	selected="$(selected_branch "$branch")"
	note_file="$(notes_file_for_branch "$selected")"
	acquire_notes_lock
	validate_notes_file "$note_file"
	[ -f "$note_file" ] || {
		printf 'No notes found for branch: %s\n' "$selected" >&2
		exit 1
	}
	matches="$(jq --arg id "$id" '[((.notes // [])[]) | select($id == "" or (.id | tostring) == $id)] | length' "$note_file")"
	if [ "$matches" -eq 0 ]; then
		if [ -n "$id" ]; then
			printf 'Note not found: %s\n' "$id" >&2
		else
			printf 'No notes found for branch: %s\n' "$selected" >&2
		fi
		exit 1
	fi

	now="$(now_utc)"
	jq \
		--arg branch "$selected" \
		--arg id "$id" \
		--arg now "$now" \
		--arg reason "$reason" \
		--argjson archived "$archived" \
		'
			if type == "object" then . else {version:1,meta:{branch:$branch,created_at:$now},notes:[]} end
			| .version = 1
			| .meta.branch = $branch
			| .meta.created_at = (.meta.created_at // $now)
			| .meta.updated_at = $now
			| .notes = ((.notes // []) | map(
				.branch = $branch
				| .importance = (.importance // "minor")
				|
				if $id == "" or (.id | tostring) == $id then
					.updated_at = $now
					| if $archived == 1 then
						.archived = true
						| .archived_at = $now
						| if $reason == "" then del(.archive_reason) else .archive_reason = $reason end
					else
						del(.archived) | del(.archived_at) | del(.archive_reason)
					end
				else . end
			))
		' "$note_file" | write_json "$note_file"
	printf '%s\n' "${id:-$selected}"
}

cmd_clear() {
	local branch="" yes=0 selected note_file now
	while [ "$#" -gt 0 ]; do
		case "$1" in
		--yes)
			yes=1
			shift
			;;
		--branch)
			branch="${2:-}"
			shift 2
			;;
		--branch=*)
			branch="${1#--branch=}"
			shift
			;;
		*)
			printf 'Unknown option: %s\n' "$1" >&2
			exit 1
			;;
		esac
	done
	if [ "$yes" -ne 1 ]; then
		printf 'clear removes all notes for this branch. Re-run with --yes.\n' >&2
		exit 1
	fi

	selected="$(selected_branch "$branch")"
	note_file="$(notes_file_for_branch "$selected")"
	now="$(now_utc)"
	acquire_notes_lock
	validate_notes_file "$note_file"
	if [ -s "$note_file" ]; then
		jq --arg branch "$selected" --arg now "$now" '
			if type == "object" then . else {version:1,meta:{branch:$branch,created_at:$now},notes:[]} end
			| .version = 1
			| .meta.updated_at = $now
			| .notes = []
		' "$note_file" | write_json "$note_file"
	else
		empty_document "$selected" "$now" | write_json "$note_file"
	fi
	printf '%s\n' "$note_file"
}

cmd_delete_branch() {
	local branch="" yes=0 dir file
	while [ "$#" -gt 0 ]; do
		case "$1" in
		--yes)
			yes=1
			shift
			;;
		--branch)
			branch="${2:-}"
			shift 2
			;;
		--branch=*)
			branch="${1#--branch=}"
			shift
			;;
		*)
			if [ -z "$branch" ]; then
				branch="$1"
				shift
			else
				printf 'Unknown argument: %s\n' "$1" >&2
				exit 1
			fi
			;;
		esac
	done
	if [ -z "$branch" ]; then
		printf 'delete-branch requires --branch <branch>.\n' >&2
		exit 1
	fi
	if [ "$yes" -ne 1 ]; then
		printf 'delete-branch removes the branch notes file. Re-run with --yes.\n' >&2
		exit 1
	fi

	dir="$(notes_dir_for_branch "$branch")"
	file="$dir/notes.json"
	acquire_notes_lock
	rm -f "$file"
	while [ "$dir" != "$(notes_root)" ] && [ "$dir" != "/" ]; do
		rmdir "$dir" 2>/dev/null || break
		dir="$(dirname "$dir")"
	done
	printf '%s\n' "$file"
}

case "${1:-}" in
path)
	shift
	cmd_path "$@"
	;;
branches)
	shift
	cmd_branches "$@"
	;;
add)
	shift
	cmd_add "$@"
	;;
update)
	shift
	cmd_update "$@"
	;;
list)
	shift
	cmd_list "$@"
	;;
delete)
	shift
	cmd_delete "$@"
	;;
archive)
	shift
	cmd_archive "$@"
	;;
clear)
	shift
	cmd_clear "$@"
	;;
delete-branch)
	shift
	cmd_delete_branch "$@"
	;;
-h | --help | "")
	usage
	;;
*)
	printf 'Unknown command: %s\n' "$1" >&2
	usage
	exit 1
	;;
esac
