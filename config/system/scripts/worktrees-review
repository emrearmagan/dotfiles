#!/usr/bin/env bash

# Create or reuse review worktrees for one branch across repositories,
# then split every pane side-by-side: pi review on the left, Atlas diff on the right.
#
# Usage:
#   worktrees-review <branch> [<repo-path...>] [--skip-unchanged] [--base=<branch>] [--target=<pull-request-url>] [--initial-width=<columns>] [--attach]
#
# Notes:
#   - Uses tmux session: reviews
#   - Sends a fixed pi prompt to each original pane
#   - Opens Atlas diff in a vertical split beside each review pane
#   - --skip-unchanged and --base are forwarded to `worktrees`
#   - --target opens Atlas diff for the pull request URL
#   - Without --target, Atlas diff opens origin/<base-or-main>...HEAD
#   - --initial-width is forwarded for first-time tmux session creation
#   - --attach attaches after review commands are sent
#   - Reviews use <repo-parent>/worktrees/<repo>/review/<branch>.
#
# Examples:
#   worktrees-review linux
#   worktrees-review linux --skip-unchanged
#   worktrees-review linux --base=develop
#   worktrees-review linux --target=https://github.com/owner/repo/pull/123
#   worktrees-review linux ~/repo/a ~/repo/b --skip-unchanged
#   worktrees-review linux --attach

set -euo pipefail

usage() {
	printf 'Usage:\n' >&2
	printf '  %s <branch> [<repo-path...>] [--skip-unchanged] [--base=<branch>] [--target=<pull-request-url>] [--initial-width=<columns>] [--attach]\n' "$(basename "$0")" >&2
	printf '\nExamples:\n' >&2
	printf '  %s linux\n' "$(basename "$0")" >&2
	printf '  %s linux --skip-unchanged --base=develop\n' "$(basename "$0")" >&2
	printf '  %s linux --target=https://github.com/owner/repo/pull/123\n' "$(basename "$0")" >&2
	printf '  %s linux --initial-width=236\n' "$(basename "$0")" >&2
	printf '  %s linux ~/repo/a ~/repo/b --skip-unchanged\n' "$(basename "$0")" >&2
	printf '  %s linux --attach\n' "$(basename "$0")" >&2
	printf '\nOptions:\n' >&2
	printf '  -h, --help                  show help\n' >&2
	printf '      --skip-unchanged        forward to worktrees\n' >&2
	printf '      --base=<branch>         forward to worktrees\n' >&2
	printf '      --target=<url>          open this pull request in Atlas diff\n' >&2
	printf '      --initial-width=<cols>  initial tmux session width\n' >&2
	printf '      --attach                attach after sending review commands\n' >&2
}

REPOS=()
SKIP_SAME=0
BASE_BRANCH=""
TARGET=""
INITIAL_WIDTH=""
ATTACH=0

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
	usage
	exit 0
fi

if [ "$#" -lt 1 ] || [[ "$1" == --* ]]; then
	usage
	exit 1
fi

BRANCH="$1"
shift

for ARG in "$@"; do
	if [ "$ARG" = "--skip-unchanged" ]; then
		SKIP_SAME=1
	elif [ "$ARG" = "--attach" ]; then
		ATTACH=1
	elif [[ "$ARG" == --base=* ]]; then
		BASE_BRANCH="${ARG#--base=}"
		if [ -z "$BASE_BRANCH" ]; then
			printf 'Base branch cannot be empty.\n' >&2
			usage
			exit 1
		fi
	elif [[ "$ARG" == --target=* ]]; then
		TARGET="${ARG#--target=}"
		if [ -z "$TARGET" ]; then
			printf 'Target cannot be empty.\n' >&2
			usage
			exit 1
		fi
	elif [[ "$ARG" == --initial-width=* ]]; then
		INITIAL_WIDTH="${ARG#--initial-width=}"
		if ! [[ "$INITIAL_WIDTH" =~ ^[1-9][0-9]*$ ]]; then
			printf 'Initial width must be a positive integer.\n' >&2
			usage
			exit 1
		fi
	elif [[ "$ARG" == --* ]]; then
		printf 'Unknown flag: %s\n' "$ARG" >&2
		usage
		exit 1
	else
		REPOS+=("$ARG")
	fi
done

if [ "${#REPOS[@]}" -eq 0 ]; then
	if ! REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"; then
		printf 'worktrees-review must run inside a git repository when no repo path is provided.\n' >&2
		exit 1
	fi
	REPOS=("$REPO_ROOT")
fi

for REPO_INPUT in "${REPOS[@]}"; do
	if ! REPO_ROOT="$(git -C "$REPO_INPUT" rev-parse --show-toplevel 2>/dev/null)"; then
		printf 'Not a git repository: %s\n' "$REPO_INPUT" >&2
		exit 1
	fi
	REPO_NAME="$(basename "$REPO_ROOT")"
	REVIEW_ROOT="$(dirname "$REPO_ROOT")/worktrees/$REPO_NAME/review"
	if [ -d "$REVIEW_ROOT/.git" ] || [ -f "$REVIEW_ROOT/.git" ]; then
		printf 'Branch name "review" is reserved for review worktrees.\n' >&2
		exit 1
	fi
done

SESSION="reviews"
MODEL="openai-codex/gpt-5.6-sol"
PROMPT='/review this branch versus its base branch (fallback: main).'
if [ -n "$TARGET" ]; then
	PROMPT="$PROMPT Pull request: $TARGET"
fi

WORKTREES_ARGS=("$BRANCH" "${REPOS[@]}" "--namespace=review" "--session=$SESSION")
if [ "$SKIP_SAME" -eq 1 ]; then
	WORKTREES_ARGS+=("--skip-unchanged")
fi
if [ -n "$BASE_BRANCH" ]; then
	WORKTREES_ARGS+=("--base=$BASE_BRANCH")
fi
if [ -n "$INITIAL_WIDTH" ]; then
	WORKTREES_ARGS+=("--initial-width=$INITIAL_WIDTH")
fi

if ! worktrees "${WORKTREES_ARGS[@]}"; then
	exit 1
fi

WINDOW_TARGET="$(tmux list-windows -t "$SESSION" -F '#{window_active} #{session_name}:#{window_name}' | grep '^1 ' | head -n 1 | cut -d' ' -f2-)"

if [ -z "$WINDOW_TARGET" ]; then
	printf 'Could not determine active tmux window in session %s.\n' "$SESSION" >&2
	exit 1
fi

DIFF_TARGET="${TARGET:-origin/${BASE_BRANCH:-main}...HEAD}"

ESCAPED_PROMPT="${PROMPT//\'/\'\\\'\'}"
COMMAND="pi --no-session --model '$MODEL' '$ESCAPED_PROMPT'"
printf -v ATLAS_COMMAND 'nvim -c %q' "Atlas diff $DIFF_TARGET"

while IFS= read -r pane; do
	diff_pane="$(tmux split-window -h -p 70 -t "$pane" -c '#{pane_current_path}' -P -F '#{pane_id}')"
	tmux send-keys -t "$diff_pane" "$ATLAS_COMMAND" Enter
	tmux send-keys -t "$pane" "$COMMAND" Enter
done < <(tmux list-panes -t "$WINDOW_TARGET" -F '#{pane_id}')

if [ "$ATTACH" -eq 1 ]; then
	if [ -z "${TMUX:-}" ]; then
		tmux attach -t "$WINDOW_TARGET"
	else
		tmux switch-client -t "$SESSION"
		tmux select-window -t "$WINDOW_TARGET"
	fi
fi
