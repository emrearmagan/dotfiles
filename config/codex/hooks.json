{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/sketchybar/helpers/agent-status.sh UserPromptSubmit codex"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/sketchybar/helpers/agent-status.sh PreToolUse codex"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/sketchybar/helpers/agent-status.sh PostToolUse codex"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/sketchybar/helpers/agent-status.sh PermissionRequest codex"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/sketchybar/helpers/agent-status.sh Stop codex"
          }
        ]
      }
    ]
  }
}
