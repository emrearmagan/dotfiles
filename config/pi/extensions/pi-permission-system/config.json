{
  "debugLog": false,
  "permissionReviewLog": false,
  "yoloMode": true,
  "permission": {
    "*": "allow",
    "external_directory": {
      "*": "ask",
      "~/.pi/agent/agents/*": "allow",
      "~/.pi/agent/skills/*": "allow"
    },
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.dist": "allow",
      "*.env.example": "allow",
      "*.env.sample": "allow",
      ".dev.vars": "deny"
    },
    "bash": {
      "*": "ask",

      "gh issue comment*": "ask",
      "gh issue create*": "ask",
      "gh pr comment*": "ask",
      "gh pr create*": "ask",
      "gh pr merge*": "ask",
      "gh pr review*": "ask",
      "git -C * push*": "ask",
      "git checkout*": "ask",
      "git commit*": "ask",
      "git push*": "ask",
      "git rebase*": "ask",
      "git reset --hard*": "ask",
      "git stash*": "ask",
      "git switch*": "ask",

      "env *": "deny",
      "printenv*": "deny",
      "rm -rf *": "deny",
      "sudo *": "deny"
    }
  }
}
