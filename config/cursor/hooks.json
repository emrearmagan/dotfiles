{
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "$HOME/.config/scripts/agent-status-hook --event working --provider cursor"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "$HOME/.config/scripts/agent-status-hook --event working --provider cursor"
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "$HOME/.config/scripts/agent-status-hook --event working --provider cursor"
      }
    ],
    "afterAgentResponse": [
      {
        "command": "$HOME/.config/scripts/agent-status-hook --event idle --provider cursor"
      }
    ],
    "stop": [
      {
        "command": "$HOME/.config/scripts/agent-status-hook --event idle --provider cursor"
      }
    ],
    "sessionEnd": [
      {
        "command": "$HOME/.config/scripts/agent-status-hook --event close --provider cursor"
      }
    ]
  },
  "version": 1
}
