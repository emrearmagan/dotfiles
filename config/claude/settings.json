{
  "env": {
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1"
  },
  "permissions": {
    "ask": [
      "Bash(gh issue comment *)",
      "Bash(gh issue create *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr review *)",
      "Bash(git -C * push *)",
      "Bash(git checkout *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git rebase *)",
      "Bash(git reset --hard *)",
      "Bash(git stash *)",
      "Bash(git switch *)"
    ],
    "deny": [
      "Bash(env *)",
      "Bash(printenv *)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Edit(**/.dev.vars)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Read(**/.dev.vars)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  },
  "model": "opus",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/scripts/agent-status-hook --event UserPromptSubmit --provider claude"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/scripts/agent-status-hook --event PreToolUse --provider claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/scripts/agent-status-hook --event PostToolUse --provider claude"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/scripts/agent-status-hook --event Stop --provider claude"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/scripts/agent-status-hook --event Notification --provider claude"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/scripts/agent-status-hook --event SessionEnd --provider claude"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "prismantis": {
      "source": {
        "source": "github",
        "repo": "NahumLitvin/prismantis"
      }
    }
  },
  "feedbackDrafts": "off",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "pluginConfigs": {},
  "tui": "fullscreen",
  "theme": "dark",
  "skipAutoPermissionPrompt": true
}
