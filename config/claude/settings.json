{
  "env": {
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1"
  },
  "permissions": {
    "allow": [
      "mcp__pencil"
    ]
  },
  "model": "opus",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/scripts/agent-status-hook --event UserPromptSubmit --provider claude"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/scripts/agent-status-hook --event PreToolUse --provider claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/scripts/agent-status-hook --event PostToolUse --provider claude"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/scripts/agent-status-hook --event Stop --provider claude"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/scripts/agent-status-hook --event Notification --provider claude"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/scripts/agent-status-hook --event SessionEnd --provider claude"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true,
    "prismantis@prismantis": true
  },
  "extraKnownMarketplaces": {
    "prismantis": {
      "source": {
        "source": "github",
        "repo": "NahumLitvin/prismantis"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "pluginConfigs": {
    "prismantis@prismantis": {
      "options": {
        "enabled": true,
        "theme": "catppuccin-mocha",
        "headingStyle": "banner",
        "tableStyle": "box",
        "promptStyle": "off",
        "clock": "off",
        "toolStyle": "chat",
        "toolOutput": "full",
        "taskStyle": "checks",
        "rtl": "auto",
        "highlightNumbers": true,
        "highlightPaths": true,
        "mermaidAscii": false,
        "toolRows": true,
        "diffStyle": "card",
        "mermaid": true,
        "copyButtons": true,
        "copyButtonStyle": "inline",
        "issueHint": true,
        "diagramHints": true,
        "latex": false
      }
    }
  },
  "tui": "fullscreen",
  "theme": "dark",
  "skipAutoPermissionPrompt": true
}
