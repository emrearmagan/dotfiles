#!/usr/bin/env bash

# Create or reuse worktrees for one branch across multiple repositories,
# then split every pane side-by-side: pi review on the left, AtlasDiff on the right.
#
# Usage:
#   worktrees-review <branch> [--skip-unchanged] [--base=<branch>] [--target=<pull-request-url>] [--attach]
#   worktrees-review <branch> <destination> <repo-path...> [--skip-unchanged] [--base=<branch>] [--target=<pull-request-url>] [--attach]
#
# Notes:
#   - Uses tmux session: reviews
#   - Sends a fixed pi prompt to each original pane
#   - Opens AtlasDiff in a vertical split beside each review pane
#   - --skip-unchanged and --base are forwarded to `worktrees`
#   - --target opens AtlasDiff for the pull request URL
#   - Without --target, AtlasDiff opens origin/<base-or-main>...HEAD
#   - --attach attaches after review commands are sent
#   - branch-only mode uses current repo with destination at ./reviews
#
# Examples:
#   worktrees-review linux
#   worktrees-review linux --skip-unchanged
#   worktrees-review linux --base=develop
#   worktrees-review linux --target=https://github.com/owner/repo/pull/123
#   worktrees-review linux --attach
#   worktrees-review linux ~/reviews ~/repo/a ~/repo/b --skip-unchanged

set -euo pipefail

usage() {
	printf 'Usage:\n' >&2
	printf '  %s <branch> [--skip-unchanged] [--base=<branch>] [--target=<pull-request-url>] [--attach]\n' "$(basename "$0")" >&2
	printf '  %s <branch> <destination> <repo-path...> [--skip-unchanged] [--base=<branch>] [--target=<pull-request-url>] [--attach]\n' "$(basename "$0")" >&2
	printf '\nExamples:\n' >&2
	printf '  %s linux\n' "$(basename "$0")" >&2
	printf '  %s linux --skip-unchanged --base=develop\n' "$(basename "$0")" >&2
	printf '  %s linux --target=https://github.com/owner/repo/pull/123\n' "$(basename "$0")" >&2
	printf '  %s linux --attach\n' "$(basename "$0")" >&2
	printf '  %s linux ~/reviews ~/repo/a ~/repo/b --skip-unchanged\n' "$(basename "$0")" >&2
	printf '\nOptions:\n' >&2
	printf '  -h, --help                  show help\n' >&2
	printf '      --skip-unchanged        forward to worktrees\n' >&2
	printf '      --base=<branch>         forward to worktrees\n' >&2
	printf '      --target=<url>          open this pull request in AtlasDiff\n' >&2
	printf '      --attach                attach after sending review commands\n' >&2
}

REPOS=()
SKIP_SAME=0
BASE_BRANCH=""
TARGET=""
ATTACH=0
POSITIONAL=()

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
	usage
	exit 0
fi

if [ "$#" -lt 1 ] || [[ "$1" == --* ]]; then
	usage
	exit 1
fi

BRANCH="$1"
DESTINATION=""
shift

for ARG in "$@"; do
	if [ "$ARG" = "--skip-unchanged" ]; then
		SKIP_SAME=1
	elif [ "$ARG" = "--attach" ]; then
		ATTACH=1
	elif [[ "$ARG" == --base=* ]]; then
		BASE_BRANCH="${ARG#--base=}"
		if [ -z "$BASE_BRANCH" ]; then
			printf 'Base branch cannot be empty.\n' >&2
			usage
			exit 1
		fi
	elif [[ "$ARG" == --target=* ]]; then
		TARGET="${ARG#--target=}"
		if [ -z "$TARGET" ]; then
			printf 'Target cannot be empty.\n' >&2
			usage
			exit 1
		fi
	elif [[ "$ARG" == --* ]]; then
		printf 'Unknown flag: %s\n' "$ARG" >&2
		usage
		exit 1
	else
		POSITIONAL+=("$ARG")
	fi
done

if [ "${#POSITIONAL[@]}" -eq 0 ]; then
	if ! REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"; then
		printf 'Branch-only mode requires running inside a git repository.\n' >&2
		exit 1
	fi
	DESTINATION="$REPO_ROOT/reviews"
	REPOS=("$REPO_ROOT")
	printf 'Using current repo: %s\n' "$REPO_ROOT"
else
	if [ "${#POSITIONAL[@]}" -lt 2 ]; then
		printf 'When passing positional args after <branch>, provide both <destination> and at least one <repo-path>.\n' >&2
		usage
		exit 1
	fi
	DESTINATION="${POSITIONAL[0]}"
	REPOS=("${POSITIONAL[@]:1}")
fi

SESSION="reviews"
MODEL="openai-codex/gpt-5.4"
PROMPT='/review this branch versus its base branch (fallback: main).'
if [ -n "$TARGET" ]; then
	PROMPT="$PROMPT Pull request: $TARGET"
fi

WORKTREES_ARGS=("$BRANCH" "$DESTINATION" "${REPOS[@]}" "--session=$SESSION")
if [ "$SKIP_SAME" -eq 1 ]; then
	WORKTREES_ARGS+=("--skip-unchanged")
fi
if [ -n "$BASE_BRANCH" ]; then
	WORKTREES_ARGS+=("--base=$BASE_BRANCH")
fi

if ! worktrees "${WORKTREES_ARGS[@]}"; then
	exit 1
fi

WINDOW_TARGET="$(tmux list-windows -t "$SESSION" -F '#{window_active} #{session_name}:#{window_name}' | grep '^1 ' | head -n 1 | cut -d' ' -f2-)"

if [ -z "$WINDOW_TARGET" ]; then
	printf 'Could not determine active tmux window in session %s.\n' "$SESSION" >&2
	exit 1
fi

ATLASDIFF_TARGET="${TARGET:-origin/${BASE_BRANCH:-main}...HEAD}"

ESCAPED_PROMPT="${PROMPT//\'/\'\\\'\'}"
COMMAND="pi --no-session --model '$MODEL' '$ESCAPED_PROMPT'"
printf -v ATLASDIFF_COMMAND 'nvim -c %q' "AtlasDiff $ATLASDIFF_TARGET"

while IFS= read -r pane; do
	atlasdiff_pane="$(tmux split-window -h -t "$pane" -c '#{pane_current_path}' -P -F '#{pane_id}')"
	tmux send-keys -t "$atlasdiff_pane" "$ATLASDIFF_COMMAND" Enter
	tmux send-keys -t "$pane" "$COMMAND" Enter
done < <(tmux list-panes -t "$WINDOW_TARGET" -F '#{pane_id}')

if [ "$ATTACH" -eq 1 ]; then
	if [ -z "${TMUX:-}" ]; then
		tmux attach -t "$WINDOW_TARGET"
	else
		tmux switch-client -t "$SESSION"
		tmux select-window -t "$WINDOW_TARGET"
	fi
fi
